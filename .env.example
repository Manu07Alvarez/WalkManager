# PostgreSQL Database (PostGIS)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/walkmanager
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=walkmanager
POSTGRES_PORT=5432

# DragonflyDB (Redis-compatible Cache & Rate Limiting)
DRAGONFLY_URL=redis://localhost:6379
DRAGONFLY_PORT=6379

# SeaweedFS (Distributed Object & Media Storage)
SEAWEEDFS_MASTER_URL=http://localhost:9333
SEAWEEDFS_FILER_URL=http://localhost:8888
SEAWEEDFS_S3_URL=http://localhost:8333
SEAWEEDFS_MASTER_PORT=9333
SEAWEEDFS_FILER_PORT=8888
SEAWEEDFS_S3_PORT=8333
SEAWEEDFS_VOLUME_PORT=8080

# JWT Authentication Keys
JWT_PUBLIC_KEY=your_public_key_here
JWT_PRIVATE_KEY=your_private_key_here

# Application Settings
RUST_LOG=info
PORT=8080
HOST=0.0.0.0

# Frontend Settings
VITE_API_URL=/api
VITE_WS_URL=ws://localhost:8080/ws

# Test Database URL
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/walkmanager_test