# PostgreSQL Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/walkmanager

# DragonflyDB (Redis-compatible)
DRAGONFLY_URL=redis://localhost:6379

# SeaweedFS
SEAWEEDFS_MASTER_URL=http://localhost:9333
SEAWEEDFS_FILER_URL=http://localhost:8888

# JWT Keys (place your actual keys in .env.local)
JWT_PUBLIC_KEY=
JWT_PRIVATE_KEY=

# Notification Providers (configured in deployment)
EMAIL_PROVIDER=
SMS_PROVIDER=

# App Settings
RUST_LOG=info
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/walkmanager_test